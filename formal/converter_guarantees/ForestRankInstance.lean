def tables (f : Fin 10) : List FiniteWord :=
  [table0,table1,table2,table3,table4,table5,table6,table7,table8,table9].get f

theorem actual_tables_sorted : ∀ f, (tables f).Pairwise wordLE := by decide

theorem actual_tables_bounded : ∀ f, (tables f).length ≤ 16777216 := by decide

theorem actual_root_volume : (rootBox tables).volume = 113490710609736499200 := by decide

/-- Concrete threshold tables, but forest import/native implementation remain
    typed inputs to the specification. This is a class theorem, not score equality. -/
theorem class_conversion_on_actual_tables {Word Label : Type}
    (forest : List (Tree (SourceQuestion tables) Word))
    (nativeTransform : List Word → Label) :
    (∀ x : RawInput,
      eval truth (fullForestTree tables actual_tables_bounded forest nativeTransform)
        (encode tables x).toCell = nativeTransform (rawWords forest x)) ∧
    nodes (fullForestTree tables actual_tables_bounded forest nativeTransform) ≤
      226981421219472998399 := by
  have h := full_forest_class_equivalence_and_finite_size tables actual_tables_bounded
    actual_tables_sorted forest nativeTransform
  constructor
  · exact h.1
  · rw [actual_root_volume] at h
    exact h.2

/-- This fallback bound cannot certify the requested disk capacity. It says
    nothing about the smallest actual equivalent class tree. -/
theorem fallback_fixed_file_upper_exceeds_4TB :
    4000000000000 < 384 + 352 * (226981421219472998399 : Nat) := by decide

#print axioms actual_tables_sorted
#print axioms actual_tables_bounded
#print axioms actual_root_volume
#print axioms class_conversion_on_actual_tables
#print axioms fallback_fixed_file_upper_exceeds_4TB
end ForestRankInstance
